# Copy to keystore.properties (gitignored) to sign release builds locally.
# CI supplies the same four values as environment variables instead:
#   KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD
#
# Generate a key (25+ year validity — losing it strands every installed user):
#   keytool -genkeypair -v -keystore tickbox-release.jks -alias tickbox \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Back the keystore up in at least two places before the first release.

storeFile=/absolute/path/to/tickbox-release.jks
storePassword=
keyAlias=tickbox
keyPassword=
